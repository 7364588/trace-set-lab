    "test": "npm run build && node --test test/*.test.mjs",
    "demo": "npm run build && node scripts/demo.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": { "@types/node": "22.20.3", "typescript": "7.0.2" }
