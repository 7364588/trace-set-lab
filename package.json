{
  "name": "trace-set-lab",
  "version": "0.1.0",
  "description": "Offline comparison and regression reports for recorded agent trace cohorts",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "bin": { "trace-set-lab": "dist/cli.js" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
